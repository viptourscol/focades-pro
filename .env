VITE_SUPABASE_URL=https://jwifxjzxdxjntbdqbyku.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_em5D2P5WLzyhacklDGpXBA_GfQniMHk

# Service role key (solo para scripts de servidor, nunca en el navegador)
# Obtenla en: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_KEY=VERCEL_TOKEN="TU_TOKEN"

# Resend API Key para envío de emails de activación
# Obtenla en: https://app.resend.com/api-keys
# Formato: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dominio verificado: focades.info
# ⚠️  NUNCA commitear la clave real - usar .env.local en desarrollo
RESEND_API_KEY=re_test_placeholder_replace_with_your_actual_key

# Cloudflare R2 Configuration
# Generar en: Cloudflare → R2 → Account API Tokens
# ⚠️  NUNCA commitear las claves reales - usar .env.local en desarrollo
VITE_R2_ACCESS_KEY_ID=COLOCA_TU_ACCESS_KEY_ID_AQUI
VITE_R2_SECRET_ACCESS_KEY=COLOCA_TU_SECRET_ACCESS_KEY_AQUI
VITE_R2_ENDPOINT=https://82fdb4a6fd4628d720932bee674b6f7d.r2.cloudflarestorage.com
